/* ============================================================
   ChoseWay（千往）红黑赛博科技风 —— Unity UI Toolkit 样式（USS）
   适用：EditorWindow / 运行时 UIDocument（Unity 2021.3+，transition 需 2021.3+）
   用法：rootVisualElement.styleSheets.Add(uss); rootVisualElement.AddToClassList("cw-root");
   降级说明：USS 无渐变 / 阴影 / 模糊 / text-stroke → 以实底 + 半透明描边替代（见 PLATFORMS.md 第 4 节）。
   取值来源：tokens.json
   ============================================================ */

/* ———— 变量（USS 自定义属性，Unity 2021.2+） ———— */
.cw-root {
  --cw-bg: #070707;
  --cw-panel-solid: rgba(18, 18, 18, 0.94);
  --cw-panel-soft: rgba(255, 255, 255, 0.035);
  --cw-card: rgba(255, 255, 255, 0.04);
  --cw-card-hover: rgba(255, 255, 255, 0.07);
  --cw-line: rgba(255, 255, 255, 0.09);
  --cw-line-soft: rgba(255, 255, 255, 0.07);
  --cw-line-strong: rgba(255, 255, 255, 0.16);
  --cw-input-bg: rgba(0, 0, 0, 0.2);
  --cw-text: #F4EFE9;
  --cw-muted: #B9AEA4;
  --cw-faint: rgba(255, 255, 255, 0.42);
  --cw-eyebrow: rgba(255, 255, 255, 0.62);
  --cw-red: #D4121F;
  --cw-red-bright: #FF3748;
  --cw-red-mid: #E0232F;              /* 无渐变时的主按钮单色（两端取中） */
  --cw-red-fill: rgba(212, 18, 31, 0.16);
  --cw-red-border: rgba(255, 82, 95, 0.40);
  --cw-red-text: #FFB3BA;
  --cw-gold: #E8B54A;
  --cw-gold-text: #FFD98A;
  --cw-warn: #D9A13B;
  --cw-orange: #FF8C3B;
  --cw-ok: #46C576;
  --cw-link: #7FA0DC;

  background-color: var(--cw-bg);
  color: var(--cw-text);
  font-size: 12px;                    /* 编辑器更紧凑：正文 12 / 眉标 11 / 标题 18 */
  flex-grow: 1;
  padding: 12px;
}
/* 左上角红色氛围晕：用一个绝对定位的半透明块近似（无径向渐变） */
.cw-root__tint {
  position: absolute; left: 0; top: 0; width: 260px; height: 160px;
  background-color: rgba(212, 18, 31, 0.08);
  border-bottom-right-radius: 200px;
  /* 可再叠一层更小更淡的块增强衰减感 */
}

/* ———— 排版 ———— */
.cw-title { font-size: 18px; -unity-font-style: bold; letter-spacing: -0.5px; color: var(--cw-text); margin-bottom: 10px; }
.cw-sub { font-size: 11px; color: var(--cw-muted); }
.cw-eyebrow { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; color: var(--cw-eyebrow); margin-bottom: 10px; }
/* 注意：USS 没有 text-transform，眉标文字请在代码里 .ToUpperInvariant() */
.cw-muted { color: var(--cw-muted); }
.cw-faint { color: var(--cw-faint); }
.cw-mono { -unity-font-definition: initial; color: var(--cw-muted); }
.cw-bignum { font-size: 34px; -unity-font-style: bold-and-italic; color: rgba(255, 55, 72, 0.55); letter-spacing: -1px; }

/* ———— 面板 / 卡片 ———— */
.cw-panel {
  background-color: var(--cw-card);
  border-width: 1px; border-color: var(--cw-line);
  border-radius: 18px;                /* 编辑器窗口比网页小一号：22→18 */
  padding: 14px 16px;
  margin-bottom: 10px;
}
.cw-card {
  background-color: rgba(18, 18, 18, 0.9);
  border-width: 1px; border-color: var(--cw-line);
  border-radius: 14px;
  padding: 10px 12px;
  transition-property: border-color, background-color, translate;
  transition-duration: 0.15s;
}
.cw-card:hover { border-color: var(--cw-line-strong); translate: 0 -2px; }
.cw-card--active { border-color: var(--cw-red-border); }
.cw-empty {
  border-width: 1px; border-color: var(--cw-line-strong);
  border-radius: 18px; padding: 28px 16px;
  background-color: var(--cw-panel-soft);
  color: var(--cw-faint); -unity-text-align: middle-center;
}
.cw-divider { height: 1px; background-color: var(--cw-line-soft); margin: 8px 0; }

/* ———— 按钮（给 Button 加 .cw-btn；.primary / .ghost / .danger / .sm） ———— */
.cw-btn {
  height: 32px; min-height: 32px; padding: 0 16px; margin: 0 4px 0 0;
  border-radius: 999px;
  border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
  background-color: var(--cw-card);
  color: #FFFFFF; font-size: 12px; -unity-font-style: bold;
  -unity-text-align: middle-center;
  transition-property: background-color, border-color, scale;
  transition-duration: 0.15s;
}
.cw-btn:hover { background-color: var(--cw-card-hover); border-color: var(--cw-line-strong); }
.cw-btn:active { scale: 0.98 0.98; }
.cw-btn.primary { background-color: var(--cw-red-mid); border-color: rgba(255, 55, 72, 0.5); }
.cw-btn.primary:hover { background-color: var(--cw-red-bright); }
.cw-btn.ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--cw-muted); }
.cw-btn.ghost:hover { color: var(--cw-text); background-color: var(--cw-card); }
.cw-btn.danger { background-color: rgba(212, 18, 31, 0.14); border-color: rgba(255, 82, 95, 0.22); color: var(--cw-red-text); }
.cw-btn.danger:hover { background-color: rgba(212, 18, 31, 0.24); border-color: var(--cw-red-border); color: #FFFFFF; }
.cw-btn.sm { height: 26px; min-height: 26px; padding: 0 11px; font-size: 11px; }
.cw-btn:disabled { opacity: 0.45; }
.cw-iconbtn {
  width: 24px; height: 24px; padding: 0; margin: 0;
  border-width: 0; border-radius: 7px; background-color: rgba(0, 0, 0, 0);
  color: var(--cw-muted); -unity-text-align: middle-center;
}
.cw-iconbtn:hover { background-color: var(--cw-card-hover); color: var(--cw-text); }

/* ———— 输入（TextField / IntegerField 等加 .cw-input） ———— */
.cw-input { margin: 0; }
.cw-input > #unity-text-input,
.cw-input .unity-base-text-field__input {
  background-color: var(--cw-input-bg);
  border-width: 1px; border-color: rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  padding: 6px 12px; min-height: 30px;
  color: #FFFFFF; font-size: 12px;
  transition-property: border-color; transition-duration: 0.15s;
}
.cw-input:focus > #unity-text-input,
.cw-input .unity-base-text-field__input:focus { border-color: var(--cw-red-border); }
.cw-input .unity-base-field__label { color: rgba(255, 255, 255, 0.64); font-size: 11px; min-width: 70px; }
.cw-toggle .unity-toggle__checkmark { background-color: var(--cw-input-bg); border-color: rgba(255, 255, 255, 0.2); border-radius: 4px; }
.cw-toggle:checked .unity-toggle__checkmark { background-color: var(--cw-red); border-color: var(--cw-red-bright); }
.cw-slider .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.12); border-radius: 999px; height: 5px; }
.cw-slider .unity-base-slider__dragger { background-color: var(--cw-red-bright); border-color: #1A1A1A; border-width: 2px; border-radius: 999px; width: 16px; height: 16px; }

/* ———— 标签 / 胶囊 / 分段 ———— */
.cw-tag {
  flex-direction: row; align-items: center; align-self: flex-start;
  height: 22px; padding: 0 9px; margin-right: 5px;
  border-radius: 999px; border-width: 1px; border-color: var(--cw-line);
  background-color: var(--cw-panel-soft);
  color: var(--cw-muted); font-size: 10.5px; -unity-font-style: bold;
}
.cw-tag.red  { background-color: var(--cw-red-fill); border-color: rgba(255, 82, 95, 0.22); color: var(--cw-red-text); }
.cw-tag.warn { background-color: rgba(217, 161, 59, 0.12); border-color: rgba(217, 161, 59, 0.35); color: var(--cw-warn); }
.cw-tag.ok   { background-color: rgba(70, 197, 118, 0.10); border-color: rgba(70, 197, 118, 0.30); color: var(--cw-ok); }
.cw-tag.gold { background-color: rgba(232, 181, 74, 0.13); border-color: rgba(232, 181, 74, 0.42); color: var(--cw-gold-text); }
.cw-tag.link { background-color: rgba(0, 0, 0, 0); border-color: rgba(127, 160, 220, 0.35); color: var(--cw-link); }
.cw-chip {
  height: 26px; padding: 0 12px; margin: 0 4px 0 0;
  border-radius: 999px; border-width: 1px; border-color: var(--cw-line);
  background-color: var(--cw-panel-soft);
  color: var(--cw-muted); font-size: 11px; -unity-font-style: bold;
  transition-property: background-color, border-color, color; transition-duration: 0.15s;
}
.cw-chip:hover { color: var(--cw-text); border-color: var(--cw-line-strong); }
.cw-chip.on { background-color: rgba(212, 18, 31, 0.18); border-color: var(--cw-red-border); color: var(--cw-red-text); }
.cw-seg {
  flex-direction: row; align-self: flex-start; padding: 3px;
  border-width: 1px; border-color: var(--cw-line); border-radius: 999px;
  background-color: var(--cw-input-bg);
}
.cw-seg > .cw-segbtn {
  height: 26px; padding: 0 12px; margin: 0; border-width: 0; border-radius: 999px;
  background-color: rgba(0, 0, 0, 0); color: var(--cw-muted); font-size: 11.5px; -unity-font-style: bold;
}
.cw-seg > .cw-segbtn:hover { color: var(--cw-text); }
.cw-seg > .cw-segbtn.active { background-color: var(--cw-card-hover); color: #FFFFFF; border-width: 1px; border-color: var(--cw-line-strong); }

/* ———— 状态点 / 优先级色条 / 进度 ———— */
.cw-dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--cw-faint); margin-right: 6px; }
.cw-dot.on   { background-color: var(--cw-ok); border-width: 1px; border-color: rgba(70, 197, 118, 0.5); }
.cw-dot.off  { background-color: var(--cw-red-bright); border-width: 1px; border-color: rgba(255, 55, 72, 0.5); }
.cw-dot.warn { background-color: var(--cw-warn); }
/* 象限色条：把一个 3px 宽的 VisualElement 放在卡片左缘（卡片 position:relative；色条 absolute left:0 top:12 bottom:12） */
.cw-quadbar { position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; }
.cw-quadbar.iu { background-color: var(--cw-red-bright); }
.cw-quadbar.i  { background-color: var(--cw-gold); opacity: 0.9; }
.cw-quadbar.u  { background-color: var(--cw-orange); }
.cw-quadbar.n  { background-color: rgba(255, 255, 255, 0.22); }
.cw-card.qd-iu { border-color: rgba(255, 82, 95, 0.32); transition-property: border-color; transition-duration: 0.9s; }
.cw-card.qd-iu.breath { border-color: rgba(255, 55, 72, 0.85); }   /* 脚本每 --fx-speed/2 切换 .breath 实现呼吸 */
.cw-card.qd-n { opacity: 0.68; }
.cw-progress-track { height: 6px; border-radius: 999px; background-color: rgba(255, 255, 255, 0.12); }
.cw-progress-fill { height: 6px; border-radius: 999px; background-color: var(--cw-red); }

/* ———— 列表 / 表头 ———— */
.cw-th { font-size: 10.5px; -unity-font-style: bold; letter-spacing: 0.7px; color: var(--cw-faint); padding: 6px 10px; border-bottom-width: 1px; border-bottom-color: var(--cw-line); }
.cw-tr { flex-direction: row; padding: 7px 10px; border-bottom-width: 1px; border-bottom-color: var(--cw-line-soft); }
.cw-tr:hover { background-color: rgba(255, 255, 255, 0.025); }

/* ———— 覆盖 Unity 默认滚动条 ———— */
.cw-root .unity-scroller--vertical { width: 10px; }
.cw-root .unity-scroller .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); }
.cw-root .unity-scroller .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.14); border-radius: 5px; border-width: 0; }
.cw-root .unity-scroller .unity-scroller__low-button, .cw-root .unity-scroller .unity-scroller__high-button { display: none; }
